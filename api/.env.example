# Azure Blob source for monthly participation
OP_PARTICIPATION_AZURE_STORAGE_ACCOUNT=seeturtlesphsa
OP_PARTICIPATION_AZURE_CONTAINER=spa
OP_PARTICIPATION_AZURE_PREFIX=2026
OP_PARTICIPATION_DUPR_BLOB_PATH=SPADUPR/members-list-sorsogonpickleballclub.csv
OP_PARTICIPATION_CLUB_MEMBERSHIP_BLOB_PATH=SPADUPR/Sorsogon Pickleball Club Member Registration (Responses) - Form Responses 1.csv

# Azure Table Storage for member accounts and sessions
MEMBERS_AZURE_STORAGE_ACCOUNT=seeturtlesphsa
MEMBERS_AZURE_TABLE=Members
MEMBERS_SESSIONS_AZURE_TABLE=Sessions
MEMBER_SESSION_TTL_HOURS=24

# Comma-separated deployed frontend origins. Localhost and 127.0.0.1 are allowed automatically.
CORS_ALLOWED_ORIGINS=https://your-app.example.com

# Public frontend URL used in verification emails
PUBLIC_APP_URL=http://localhost:4200
EMAIL_VERIFICATION_TTL_MINUTES=60

# Mailgun HTTP API credentials for verification emails (avoids SMTP ports blocked by some networks)
MAILGUN_API_KEY=replace-me
MAILGUN_DOMAIN=mg.example.com
MAILGUN_BASE_URL=https://api.mailgun.net
EMAIL_FROM="Sorsogon Pickleball Arena <mailer@example.com>"

# Local copies and persisted player list
DUPR_MEMBERS_LOCAL_FILE_PATH=src/data/members-list-sorsogonpickleballclub.csv
CLUB_MEMBERSHIP_LOCAL_FILE_PATH=src/data/Sorsogon Pickleball Club Member Registration (Responses) - Form Responses 1.csv
PLAYER_LIST_FILE_PATH=src/data/players.json

# Optional: API port
PORT=3000
